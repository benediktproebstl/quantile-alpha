# Optional. Without a key the notebook reads FRED through its official key-less CSV endpoint.
# A free key: https://fred.stlouisfed.org/docs/api/api_key.html
#
# Local use: copy this file to ".env", fill in the key, and load it before starting Jupyter:
#     set -a; source .env; set +a
# Google Colab: add a secret named FRED_API_KEY in the "Secrets" panel instead.
# Never commit the filled-in file (".env" is listed in .gitignore).
FRED_API_KEY=
